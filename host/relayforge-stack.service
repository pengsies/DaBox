[Unit]
Description=RelayForge Compose application stack
Requires=docker.service relayforge-firewall.service relay-supervisor.service relay-backend.service
After=docker.service relayforge-firewall.service relay-supervisor.service relay-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/run/relayforge-stack
Environment=DOCKER_CONFIG=/run/relayforge-stack/docker-config
RuntimeDirectory=relayforge-stack
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/docker compose --project-directory /opt/relayforge/app --env-file /etc/relayforge/compose.env config --quiet
ExecStart=/usr/bin/docker compose --project-directory /opt/relayforge/app --env-file /etc/relayforge/compose.env up --detach --no-build --remove-orphans --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --project-directory /opt/relayforge/app --env-file /etc/relayforge/compose.env down --timeout 15
TimeoutStartSec=180
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/relayforge /etc/relayforge
ReadWritePaths=/run/relayforge-stack
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
