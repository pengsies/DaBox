[Unit]
Description=RelayForge loopback HTTP endpoint fixture
After=network.target
Before=relayforge-stack.service

[Service]
Type=exec
User=relay-backend
Group=relay-backend
ExecStart=/usr/bin/python3 /opt/relayforge/runtime/backend.py
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SocketBindDeny=any
SocketBindAllow=tcp:19001
SystemCallArchitectures=native
TasksMax=48
MemoryMax=64M
LimitNOFILE=128
LimitCORE=0

[Install]
WantedBy=multi-user.target
