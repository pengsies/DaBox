[Unit]
Description=RelayForge privileged signed-job Supervisor
After=local-fs.target network.target
Before=relayforge-stack.service
ConditionPathIsReadWrite=/var/lib/relayforge/workers

[Service]
Type=exec
User=root
Group=relayforge-ipc
ExecStart=/usr/bin/python3 /opt/relayforge/runtime/supervisor.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=relayforge
RuntimeDirectoryMode=0750
UMask=0027
# INTENTIONAL-VULNERABILITY RF-SUP-ROOT-01: this challenge variant is designed
# to turn the diagnostic pathname race into unrestricted host-root execution.
# The root child therefore shares the host filesystem, network, devices,
# namespaces, IPC, capability bounding set, and privilege domain.  Deploy only
# on a disposable, single-player machine with no IAM role or sensitive data.
NoNewPrivileges=no
PrivateDevices=no
PrivateIPC=no
PrivateTmp=no
ProtectHome=no
ProtectSystem=no
RestrictNamespaces=no
RestrictSUIDSGID=no
MemoryDenyWriteExecute=no
LockPersonality=no
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
