\set ON_ERROR_STOP on

SET password_encryption = 'scram-sha-256';

CREATE ROLE relay_owner
  NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE relay_web
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS
  CONNECTION LIMIT 20 PASSWORD :'web_pw';
CREATE ROLE relay_access
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS
  CONNECTION LIMIT 5 PASSWORD :'access_pw';
CREATE ROLE relay_dispatch
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS
  CONNECTION LIMIT 5 PASSWORD :'dispatch_pw';

ALTER ROLE relay_web SET search_path = pg_catalog;
ALTER ROLE relay_access SET search_path = pg_catalog;
ALTER ROLE relay_dispatch SET search_path = pg_catalog;
ALTER ROLE relay_web SET statement_timeout = '5s';
ALTER ROLE relay_access SET statement_timeout = '5s';
ALTER ROLE relay_dispatch SET statement_timeout = '5s';
ALTER ROLE relay_web SET idle_in_transaction_session_timeout = '5s';
ALTER ROLE relay_access SET idle_in_transaction_session_timeout = '5s';
ALTER ROLE relay_dispatch SET idle_in_transaction_session_timeout = '5s';

REVOKE ALL ON DATABASE relayforge FROM PUBLIC, relay_owner, relay_web, relay_access, relay_dispatch;
GRANT CONNECT ON DATABASE relayforge TO relay_web, relay_access, relay_dispatch;
REVOKE ALL ON SCHEMA public FROM PUBLIC, relay_owner, relay_web, relay_access, relay_dispatch;

CREATE SCHEMA extensions AUTHORIZATION postgres;
CREATE EXTENSION pgcrypto WITH SCHEMA extensions;
REVOKE ALL ON SCHEMA extensions FROM PUBLIC;
REVOKE EXECUTE ON ALL FUNCTIONS IN SCHEMA extensions FROM PUBLIC;
GRANT USAGE ON SCHEMA extensions TO relay_owner;
GRANT EXECUTE ON FUNCTION extensions.crypt(text, text) TO relay_owner;
GRANT EXECUTE ON FUNCTION extensions.gen_salt(text, integer) TO relay_owner;

CREATE SCHEMA private AUTHORIZATION relay_owner;
CREATE SCHEMA relay_web_api AUTHORIZATION relay_owner;
CREATE SCHEMA relay_access_api AUTHORIZATION relay_owner;
CREATE SCHEMA relay_dispatch_api AUTHORIZATION relay_owner;

REVOKE ALL ON SCHEMA private, relay_web_api, relay_access_api, relay_dispatch_api FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE relay_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;

SET ROLE relay_owner;

CREATE TABLE private.users (
    id uuid PRIMARY KEY,
    username text UNIQUE NOT NULL
      CHECK (username ~ '^[a-z][a-z0-9_-]{2,31}$'),
    password_hash text NOT NULL,
    enabled boolean NOT NULL DEFAULT true
);

CREATE TABLE private.targets (
    id text PRIMARY KEY
      CHECK (id ~ '^[a-z][a-z0-9-]{2,31}$'),
    display_name text NOT NULL CHECK (octet_length(display_name) BETWEEN 1 AND 96),
    endpoint_host inet NOT NULL
      CHECK (family(endpoint_host) = 4 AND masklen(endpoint_host) = 32),
    endpoint_port integer NOT NULL CHECK (endpoint_port BETWEEN 1 AND 65535),
    enabled boolean NOT NULL DEFAULT true
);

CREATE TABLE private.grants (
    user_id uuid NOT NULL REFERENCES private.users(id),
    target_id text NOT NULL REFERENCES private.targets(id),
    service text NOT NULL CHECK (service = 'echo'),
    max_duration integer NOT NULL CHECK (max_duration BETWEEN 30 AND 420),
    PRIMARY KEY (user_id, target_id, service)
);

CREATE TABLE private.requests (
    id uuid PRIMARY KEY,
    user_id uuid NOT NULL REFERENCES private.users(id),
    target_id text NOT NULL REFERENCES private.targets(id),
    service text NOT NULL CHECK (service = 'echo'),
    duration integer NOT NULL CHECK (duration BETWEEN 30 AND 420),
    options_raw text NOT NULL
      CHECK (octet_length(options_raw) BETWEEN 1 AND 512),
    state text NOT NULL DEFAULT 'pending'
      CHECK (state IN ('pending', 'reviewing', 'approved', 'denied')),
    decision_reason text CHECK (
      decision_reason IS NULL OR octet_length(decision_reason) BETWEEN 1 AND 256
    ),
    review_attempts integer NOT NULL DEFAULT 0 CHECK (review_attempts BETWEEN 0 AND 10),
    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    review_started_at timestamptz,
    reviewed_at timestamptz,
    CHECK (state <> 'denied' OR decision_reason IS NOT NULL)
);

CREATE TABLE private.jobs (
    id uuid PRIMARY KEY,
    request_id uuid UNIQUE NOT NULL REFERENCES private.requests(id),
    payload text NOT NULL CHECK (octet_length(payload) BETWEEN 1 AND 4096),
    signature bytea NOT NULL CHECK (octet_length(signature) = 64),
    state text NOT NULL DEFAULT 'ready'
      CHECK (state IN (
        'ready', 'dispatching', 'running', 'stop-ready', 'stopping',
        'stopped', 'failed', 'expired'
      )),
    state_reason text CHECK (
      state_reason IS NULL OR octet_length(state_reason) BETWEEN 1 AND 256
    ),
    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    launch_expires_at timestamptz NOT NULL,
    dispatch_started_at timestamptz,
    stop_started_at timestamptz,
    stop_attempts integer NOT NULL DEFAULT 0 CHECK (stop_attempts >= 0),
    started_at timestamptz,
    ends_at timestamptz,
    finished_at timestamptz,
    endpoint_port integer CHECK (
      endpoint_port IS NULL OR endpoint_port BETWEEN 25000 AND 25099
    ),
    session_token text CHECK (
      session_token IS NULL OR session_token ~ '^[0-9a-f]{48}$'
    ),
    CHECK (launch_expires_at > created_at),
    CHECK (
      state <> 'running'
      OR (
        endpoint_port IS NOT NULL
        AND session_token IS NOT NULL
        AND started_at IS NOT NULL
        AND ends_at IS NOT NULL
      )
    ),
    CHECK (state NOT IN ('failed', 'expired', 'stopped') OR state_reason IS NOT NULL)
);

CREATE INDEX requests_claim_idx
  ON private.requests (created_at, id) WHERE state = 'pending';
CREATE INDEX jobs_claim_idx
  ON private.jobs (created_at, id) WHERE state = 'ready';
CREATE INDEX jobs_expiry_idx
  ON private.jobs (ends_at) WHERE state = 'running';
CREATE INDEX jobs_stop_idx
  ON private.jobs (created_at, id) WHERE state = 'stop-ready';

INSERT INTO private.users (id, username, password_hash)
VALUES (
  '10000000-0000-4000-8000-000000000001',
  'guest',
  extensions.crypt('guest-relay-2026', extensions.gen_salt('bf', 12))
);
INSERT INTO private.targets (id, display_name, endpoint_host, endpoint_port)
VALUES (
  'archive-echo',
  'Archive Echo Service',
  :'target_host'::inet,
  :'target_port'::integer
);
INSERT INTO private.grants (user_id, target_id, service, max_duration)
VALUES (
  '10000000-0000-4000-8000-000000000001',
  'archive-echo',
  'echo',
  420
);

CREATE FUNCTION private.enqueue_request(
    p_username text,
    p_target text,
    p_service text,
    p_duration integer,
    p_options_raw text
) RETURNS uuid
LANGUAGE plpgsql
SECURITY INVOKER
SET search_path = pg_catalog, private, pg_temp
AS $$
DECLARE
    v_user_id uuid;
    v_request_id uuid := gen_random_uuid();
BEGIN
    IF p_service <> 'echo'
       OR p_duration NOT BETWEEN 30 AND 420
       OR p_options_raw IS NULL
       OR octet_length(p_options_raw) NOT BETWEEN 1 AND 512 THEN
        RAISE EXCEPTION 'invalid request'
          USING ERRCODE = '22023';
    END IF;

    SELECT u.id INTO v_user_id
      FROM private.users AS u
      WHERE u.username = p_username AND u.enabled;
    IF v_user_id IS NULL THEN
        RAISE EXCEPTION 'invalid principal'
          USING ERRCODE = '22023';
    END IF;

    -- Bound outstanding work per principal even when the caller reaches this
    -- RPC from the intentionally compromised web container.
    PERFORM pg_advisory_xact_lock(hashtextextended(v_user_id::text, 2212));
    IF (
      SELECT count(*)
        FROM private.requests AS outstanding
        LEFT JOIN private.jobs AS active_job ON active_job.request_id = outstanding.id
        WHERE outstanding.user_id = v_user_id
          AND (
            outstanding.state IN ('pending', 'reviewing')
            OR (
              outstanding.state = 'approved'
              AND active_job.state IN (
                'ready', 'dispatching', 'running', 'stop-ready', 'stopping'
              )
            )
          )
    ) >= 8 THEN
        RAISE EXCEPTION 'too many outstanding requests'
          USING ERRCODE = '53300';
    END IF;

    IF NOT EXISTS (
      SELECT 1 FROM private.targets AS t WHERE t.id = p_target
    ) THEN
        RAISE EXCEPTION 'invalid target'
          USING ERRCODE = '22023';
    END IF;

    INSERT INTO private.requests (
      id, user_id, target_id, service, duration, options_raw
    ) VALUES (
      v_request_id, v_user_id, p_target, p_service, p_duration, p_options_raw
    );
    RETURN v_request_id;
END;
$$;

CREATE FUNCTION relay_web_api.authenticate(p_username text, p_password text)
RETURNS boolean
LANGUAGE sql
SECURITY DEFINER
STABLE
SET search_path = pg_catalog, private, pg_temp
AS $$
  SELECT EXISTS (
    SELECT 1
      FROM private.users AS u
      WHERE u.username = p_username
        AND u.enabled
        AND u.password_hash = extensions.crypt(p_password, u.password_hash)
  );
$$;

CREATE FUNCTION relay_web_api.list_targets(p_username text)
RETURNS TABLE (
    id text,
    display_name text,
    service text,
    max_duration integer
)
LANGUAGE sql
SECURITY DEFINER
STABLE
SET search_path = pg_catalog, private, pg_temp
AS $$
  SELECT t.id, t.display_name, g.service, g.max_duration
    FROM private.users AS u
    JOIN private.grants AS g ON g.user_id = u.id
    JOIN private.targets AS t ON t.id = g.target_id
    WHERE u.username = p_username
      AND u.enabled
      AND t.enabled
    ORDER BY t.id, g.service;
$$;

CREATE FUNCTION relay_web_api.submit_safe_request(
    p_username text,
    p_target text,
    p_service text,
    p_duration integer
) RETURNS uuid
LANGUAGE sql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
  SELECT private.enqueue_request(
    p_username,
    p_target,
    p_service,
    p_duration,
    'profile=safe&note=portal'
  );
$$;

-- INTENTIONAL-VULNERABILITY RF-DB-01:
-- relay_web can submit raw legacy options, but no public HTTP route exposes them.
CREATE FUNCTION relay_web_api.submit_raw_request(
    p_username text,
    p_target text,
    p_service text,
    p_duration integer,
    p_options_raw text
) RETURNS uuid
LANGUAGE sql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
  SELECT private.enqueue_request(
    p_username,
    p_target,
    p_service,
    p_duration,
    p_options_raw
  );
$$;

CREATE FUNCTION relay_web_api.request_status(p_username text, p_request uuid)
RETURNS TABLE (
    request_id uuid,
    request_state text,
    request_reason text,
    job_id uuid,
    job_state text,
    job_reason text,
    endpoint_port integer,
    session_token text,
    started_at timestamptz,
    ends_at timestamptz
)
LANGUAGE sql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
  SELECT
    r.id,
    r.state,
    r.decision_reason,
    j.id,
    j.state,
    j.state_reason,
    CASE
      WHEN j.state = 'running' AND j.ends_at > clock_timestamp()
      THEN j.endpoint_port
    END,
    CASE
      WHEN j.state = 'running' AND j.ends_at > clock_timestamp()
      THEN j.session_token
    END,
    j.started_at,
    j.ends_at
  FROM private.requests AS r
  JOIN private.users AS u ON u.id = r.user_id
  LEFT JOIN private.jobs AS j ON j.request_id = r.id
  WHERE u.username = p_username
    AND u.enabled
    AND r.id = p_request;
$$;

CREATE FUNCTION relay_web_api.cancel_request(p_username text, p_request uuid)
RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
DECLARE
    v_changed integer;
BEGIN
    -- Requests that have not produced a Worker can be cancelled immediately.
    UPDATE private.requests AS r
      SET state = 'denied',
          decision_reason = 'cancelled-by-owner',
          review_started_at = NULL,
          reviewed_at = clock_timestamp()
      FROM private.users AS u
      WHERE r.user_id = u.id
        AND r.id = p_request
        AND u.username = p_username
        AND u.enabled
        AND r.state IN ('pending', 'reviewing');
    GET DIAGNOSTICS v_changed = ROW_COUNT;
    IF v_changed = 1 THEN
        RETURN true;
    END IF;

    -- Once a job exists, hide its token immediately and let Dispatcher obtain
    -- confirmed termination from Supervisor.  The states make retries durable.
    UPDATE private.jobs AS j
      SET state = 'stop-ready',
          state_reason = 'stop-requested',
          session_token = NULL,
          stop_started_at = NULL
      FROM private.requests AS r
      JOIN private.users AS u ON u.id = r.user_id
      WHERE j.request_id = r.id
        AND r.id = p_request
        AND u.username = p_username
        AND u.enabled
        AND j.state IN ('ready', 'dispatching', 'running');
    GET DIAGNOSTICS v_changed = ROW_COUNT;
    IF v_changed = 1 THEN
        RETURN true;
    END IF;

    RETURN EXISTS (
      SELECT 1
        FROM private.jobs AS j
        JOIN private.requests AS r ON r.id = j.request_id
        JOIN private.users AS u ON u.id = r.user_id
        WHERE r.id = p_request
          AND u.username = p_username
          AND u.enabled
          AND j.state IN ('stop-ready', 'stopping', 'stopped')
    );
END;
$$;

CREATE FUNCTION relay_access_api.claim_request()
RETURNS TABLE (
    request_id uuid,
    user_id uuid,
    target_id text,
    service text,
    duration integer,
    options_raw text
)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
BEGIN
    UPDATE private.requests AS r
      SET state = CASE
            WHEN r.review_attempts >= 3 THEN 'denied'
            ELSE 'pending'
          END,
          decision_reason = CASE
            WHEN r.review_attempts >= 3 THEN 'review-lease-exhausted'
            ELSE NULL
          END,
          review_started_at = NULL,
          reviewed_at = CASE
            WHEN r.review_attempts >= 3 THEN clock_timestamp()
            ELSE NULL
          END
      WHERE r.state = 'reviewing'
        AND r.review_started_at < clock_timestamp() - interval '30 seconds';

    RETURN QUERY
    WITH candidate AS (
      SELECT r.id
        FROM private.requests AS r
        WHERE r.state = 'pending'
        ORDER BY r.created_at, r.id
        FOR UPDATE SKIP LOCKED
        LIMIT 1
    )
    UPDATE private.requests AS r
      SET state = 'reviewing',
          decision_reason = NULL,
          review_started_at = clock_timestamp(),
          review_attempts = r.review_attempts + 1
      FROM candidate AS c
      WHERE r.id = c.id
      RETURNING
        r.id, r.user_id, r.target_id, r.service, r.duration, r.options_raw;
END;
$$;

CREATE FUNCTION relay_access_api.policy_context(p_request uuid)
RETURNS TABLE (
    grant_allowed boolean,
    max_duration integer,
    target_enabled boolean,
    endpoint_host text,
    endpoint_port integer
)
LANGUAGE sql
SECURITY DEFINER
STABLE
SET search_path = pg_catalog, private, pg_temp
AS $$
  SELECT
    EXISTS (
      SELECT 1
        FROM private.requests AS requested
        JOIN private.grants AS g
          ON g.user_id = requested.user_id
         AND g.target_id = requested.target_id
         AND g.service = requested.service
        WHERE requested.id = p_request
    ),
    COALESCE((
      SELECT g.max_duration
        FROM private.requests AS requested
        JOIN private.grants AS g
          ON g.user_id = requested.user_id
         AND g.target_id = requested.target_id
         AND g.service = requested.service
        WHERE requested.id = p_request
    ), 0),
    COALESCE((
      SELECT t.enabled
        FROM private.requests AS requested
        JOIN private.targets AS t ON t.id = requested.target_id
        WHERE requested.id = p_request
    ), false),
    COALESCE((
      SELECT host(t.endpoint_host)
        FROM private.requests AS requested
        JOIN private.targets AS t ON t.id = requested.target_id
        WHERE requested.id = p_request
    ), ''),
    COALESCE((
      SELECT t.endpoint_port
        FROM private.requests AS requested
        JOIN private.targets AS t ON t.id = requested.target_id
        WHERE requested.id = p_request
    ), 0);
$$;

CREATE FUNCTION relay_access_api.finish_request(
    p_request uuid,
    p_allowed boolean,
    p_reason text,
    p_job uuid,
    p_payload text,
    p_signature bytea,
    p_launch_expires_at timestamptz
) RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
DECLARE
    v_state text;
BEGIN
    IF p_reason IS NULL OR octet_length(p_reason) NOT BETWEEN 1 AND 256 THEN
        RAISE EXCEPTION 'invalid decision reason'
          USING ERRCODE = '22023';
    END IF;

    SELECT r.state INTO v_state
      FROM private.requests AS r
      WHERE r.id = p_request
      FOR UPDATE;
    IF NOT FOUND OR v_state <> 'reviewing' THEN
        RETURN false;
    END IF;

    IF p_allowed THEN
        IF p_job IS NULL
           OR p_payload IS NULL
           OR octet_length(p_payload) NOT BETWEEN 1 AND 4096
           OR p_signature IS NULL
           OR octet_length(p_signature) <> 64
           OR p_launch_expires_at IS NULL
           OR p_launch_expires_at <= clock_timestamp()
           OR p_launch_expires_at > clock_timestamp() + interval '120 seconds' THEN
            RAISE EXCEPTION 'invalid signed job'
              USING ERRCODE = '22023';
        END IF;

        INSERT INTO private.jobs (
          id, request_id, payload, signature, state_reason, launch_expires_at
        ) VALUES (
          p_job, p_request, p_payload, p_signature, 'awaiting-dispatch',
          p_launch_expires_at
        );
        UPDATE private.requests
          SET state = 'approved',
              decision_reason = p_reason,
              reviewed_at = clock_timestamp()
          WHERE id = p_request;
    ELSE
        UPDATE private.requests
          SET state = 'denied',
              decision_reason = p_reason,
              reviewed_at = clock_timestamp()
          WHERE id = p_request;
    END IF;
    RETURN true;
END;
$$;

CREATE FUNCTION relay_dispatch_api.expire_jobs()
RETURNS integer
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
DECLARE
    v_count integer;
    v_total integer := 0;
BEGIN
    UPDATE private.jobs
      SET state = 'expired',
          state_reason = 'launch-envelope-expired',
          finished_at = clock_timestamp(),
          session_token = NULL
      WHERE state = 'ready'
        AND launch_expires_at <= clock_timestamp();
    GET DIAGNOSTICS v_count = ROW_COUNT;
    v_total := v_total + v_count;

    UPDATE private.jobs
      SET state = 'failed',
          state_reason = 'dispatch-lease-expired',
          finished_at = clock_timestamp(),
          session_token = NULL
      WHERE state = 'dispatching'
        AND dispatch_started_at < clock_timestamp() - interval '30 seconds';
    GET DIAGNOSTICS v_count = ROW_COUNT;
    v_total := v_total + v_count;

    UPDATE private.jobs
      SET state = 'expired',
          state_reason = 'worker-lifetime-ended',
          finished_at = clock_timestamp(),
          session_token = NULL
      WHERE state = 'running'
        AND ends_at <= clock_timestamp();
    GET DIAGNOSTICS v_count = ROW_COUNT;
    v_total := v_total + v_count;

    UPDATE private.jobs
      SET state = 'stop-ready',
          state_reason = 'stop-lease-recovered',
          stop_started_at = clock_timestamp() + interval '2 seconds'
      WHERE state = 'stopping'
        AND stop_started_at < clock_timestamp() - interval '30 seconds';
    GET DIAGNOSTICS v_count = ROW_COUNT;
    v_total := v_total + v_count;

    DELETE FROM private.jobs
      WHERE state IN ('failed', 'expired', 'stopped')
        AND finished_at < clock_timestamp() - interval '1 hour';
    DELETE FROM private.requests AS old_request
      WHERE old_request.reviewed_at < clock_timestamp() - interval '1 hour'
        AND (
          old_request.state = 'denied'
          OR (
            old_request.state = 'approved'
            AND NOT EXISTS (
              SELECT 1 FROM private.jobs AS retained
                WHERE retained.request_id = old_request.id
            )
          )
        );
    RETURN v_total;
END;
$$;

CREATE FUNCTION relay_dispatch_api.claim_job()
RETURNS TABLE (
    job_id uuid,
    payload text,
    signature_hex text
)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
BEGIN
    PERFORM relay_dispatch_api.expire_jobs();
    RETURN QUERY
    WITH candidate AS (
      SELECT j.id
        FROM private.jobs AS j
        WHERE j.state = 'ready'
          AND j.launch_expires_at > clock_timestamp()
        ORDER BY j.created_at, j.id
        FOR UPDATE SKIP LOCKED
        LIMIT 1
    )
    UPDATE private.jobs AS j
      SET state = 'dispatching',
          state_reason = 'launch-in-progress',
          dispatch_started_at = clock_timestamp()
      FROM candidate AS c
      WHERE j.id = c.id
      RETURNING j.id, j.payload, encode(j.signature, 'hex');
END;
$$;

CREATE FUNCTION relay_dispatch_api.claim_stop()
RETURNS TABLE (job_id uuid)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
BEGIN
    PERFORM relay_dispatch_api.expire_jobs();
    RETURN QUERY
    WITH candidate AS (
      SELECT j.id
        FROM private.jobs AS j
        WHERE j.state = 'stop-ready'
          AND (j.stop_started_at IS NULL OR j.stop_started_at <= clock_timestamp())
        ORDER BY j.created_at, j.id
        FOR UPDATE SKIP LOCKED
        LIMIT 1
    )
    UPDATE private.jobs AS j
      SET state = 'stopping',
          state_reason = 'stop-in-progress',
          stop_started_at = clock_timestamp(),
          stop_attempts = j.stop_attempts + 1
      FROM candidate AS c
      WHERE j.id = c.id
      RETURNING j.id;
END;
$$;

CREATE FUNCTION relay_dispatch_api.finish_job(
    p_job uuid,
    p_ok boolean,
    p_port integer,
    p_token text,
    p_reason text
) RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
DECLARE
    v_state text;
    v_launch_expires_at timestamptz;
    v_duration integer;
    v_now timestamptz := clock_timestamp();
BEGIN
    SELECT j.state, j.launch_expires_at, r.duration
      INTO v_state, v_launch_expires_at, v_duration
      FROM private.jobs AS j
      JOIN private.requests AS r ON r.id = j.request_id
      WHERE j.id = p_job
      FOR UPDATE OF j;
    IF NOT FOUND OR v_state <> 'dispatching' THEN
        RETURN false;
    END IF;

    IF v_launch_expires_at <= v_now THEN
        UPDATE private.jobs
          SET state = 'expired',
              state_reason = 'launch-envelope-expired',
              finished_at = v_now,
              session_token = NULL
          WHERE id = p_job;
        RETURN false;
    END IF;

    IF p_reason IS NOT NULL AND octet_length(p_reason) > 256 THEN
        RAISE EXCEPTION 'invalid result reason'
          USING ERRCODE = '22023';
    END IF;

    IF p_ok THEN
        IF p_port NOT BETWEEN 25000 AND 25099
           OR p_token IS NULL
           OR p_token !~ '^[0-9a-f]{48}$' THEN
            RAISE EXCEPTION 'invalid launch result'
              USING ERRCODE = '22023';
        END IF;
        UPDATE private.jobs
          SET state = 'running',
              state_reason = COALESCE(NULLIF(p_reason, ''), 'worker-running'),
              endpoint_port = p_port,
              session_token = p_token,
              started_at = v_now,
              ends_at = v_now + make_interval(secs => v_duration)
          WHERE id = p_job;
    ELSE
        UPDATE private.jobs
          SET state = 'failed',
              state_reason = COALESCE(NULLIF(p_reason, ''), 'supervisor-launch-failed'),
              endpoint_port = NULL,
              session_token = NULL,
              finished_at = v_now
          WHERE id = p_job;
    END IF;
    RETURN true;
END;
$$;

CREATE FUNCTION relay_dispatch_api.finish_stop(
    p_job uuid,
    p_ok boolean,
    p_reason text
) RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, private, pg_temp
AS $$
BEGIN
    IF p_reason IS NULL OR octet_length(p_reason) NOT BETWEEN 1 AND 256 THEN
        RAISE EXCEPTION 'invalid stop result reason'
          USING ERRCODE = '22023';
    END IF;
    IF NOT EXISTS (
      SELECT 1 FROM private.jobs AS j WHERE j.id = p_job AND j.state = 'stopping'
      FOR UPDATE
    ) THEN
        RETURN false;
    END IF;
    IF p_ok THEN
        UPDATE private.jobs
          SET state = 'stopped',
              state_reason = p_reason,
              session_token = NULL,
              finished_at = clock_timestamp(),
              stop_started_at = NULL
          WHERE id = p_job;
    ELSE
        UPDATE private.jobs
          SET state = 'stop-ready',
              state_reason = p_reason,
              session_token = NULL,
              stop_started_at = clock_timestamp() + interval '2 seconds'
          WHERE id = p_job;
    END IF;
    RETURN true;
END;
$$;

RESET ROLE;

REVOKE ALL ON ALL TABLES IN SCHEMA private
  FROM PUBLIC, relay_web, relay_access, relay_dispatch;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA private
  FROM PUBLIC, relay_web, relay_access, relay_dispatch;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA private
  FROM PUBLIC, relay_web, relay_access, relay_dispatch;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA relay_web_api
  FROM PUBLIC, relay_web, relay_access, relay_dispatch;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA relay_access_api
  FROM PUBLIC, relay_web, relay_access, relay_dispatch;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA relay_dispatch_api
  FROM PUBLIC, relay_web, relay_access, relay_dispatch;

GRANT USAGE ON SCHEMA relay_web_api TO relay_web;
GRANT EXECUTE ON FUNCTION relay_web_api.authenticate(text, text) TO relay_web;
GRANT EXECUTE ON FUNCTION relay_web_api.list_targets(text) TO relay_web;
GRANT EXECUTE ON FUNCTION relay_web_api.submit_safe_request(text, text, text, integer)
  TO relay_web;
GRANT EXECUTE ON FUNCTION relay_web_api.submit_raw_request(text, text, text, integer, text)
  TO relay_web;
GRANT EXECUTE ON FUNCTION relay_web_api.request_status(text, uuid) TO relay_web;
GRANT EXECUTE ON FUNCTION relay_web_api.cancel_request(text, uuid) TO relay_web;

GRANT USAGE ON SCHEMA relay_access_api TO relay_access;
GRANT EXECUTE ON FUNCTION relay_access_api.claim_request() TO relay_access;
GRANT EXECUTE ON FUNCTION relay_access_api.policy_context(uuid) TO relay_access;
GRANT EXECUTE ON FUNCTION relay_access_api.finish_request(
  uuid, boolean, text, uuid, text, bytea, timestamptz
) TO relay_access;

GRANT USAGE ON SCHEMA relay_dispatch_api TO relay_dispatch;
GRANT EXECUTE ON FUNCTION relay_dispatch_api.expire_jobs() TO relay_dispatch;
GRANT EXECUTE ON FUNCTION relay_dispatch_api.claim_job() TO relay_dispatch;
GRANT EXECUTE ON FUNCTION relay_dispatch_api.claim_stop() TO relay_dispatch;
GRANT EXECUTE ON FUNCTION relay_dispatch_api.finish_job(
  uuid, boolean, integer, text, text
) TO relay_dispatch;
GRANT EXECUTE ON FUNCTION relay_dispatch_api.finish_stop(uuid, boolean, text)
  TO relay_dispatch;

ALTER DEFAULT PRIVILEGES FOR ROLE relay_owner
  REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;

DO $privilege_audit$
DECLARE
    v_role text;
BEGIN
    FOREACH v_role IN ARRAY ARRAY['relay_web', 'relay_access', 'relay_dispatch']
    LOOP
        IF has_database_privilege(v_role, 'relayforge', 'TEMP') THEN
            RAISE EXCEPTION '% unexpectedly has TEMP', v_role;
        END IF;
        IF EXISTS (
          SELECT 1
            FROM information_schema.role_table_grants
            WHERE grantee = v_role
              AND table_schema = 'private'
        ) THEN
            RAISE EXCEPTION '% unexpectedly has private table grants', v_role;
        END IF;
    END LOOP;
END;
$privilege_audit$;
